# Postgres connection string (Neon, Supabase, Prisma Postgres, etc).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Random secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

# Used only by prisma/seed.ts to create the first owner account.
ADMIN_NAME="Owner Name"
ADMIN_CODE="owner"
ADMIN_PIN="123456"

# Second-factor password gating the Invoices tab, separate from the admin
# login. Anyone with the owner login can use the dashboard, but only whoever
# knows this can view/generate client invoices.
INVOICE_PASSWORD="replace-with-a-password-only-you-know"

# --- Testimonial reel generator (/admin/reel) --------------------------------
# All optional. FFmpeg ships with the app via @ffmpeg-installer/ffmpeg, so
# nothing needs installing.

# Largest video you can upload, in MB. Default 1024 (1 GB).
# REEL_MAX_UPLOAD_MB="1024"

# Where uploads and renders are written. Defaults to the system temp dir.
# Video is large — point this at a drive with room if your system drive is tight.
# REEL_WORK_DIR="D:/ahmdgpt-reel-work"

# Film grain strength in the export, 0-60. Default 20. 0 turns grain off.
# Below ~12 reads as clean, ~20 is a tasteful 35mm texture, past ~30 is heavy 16mm.
# REEL_GRAIN_STRENGTH="20"

# Point at your own FFmpeg build instead of the bundled one (e.g. for
# hardware encoding or newer codec support).
# FFMPEG_PATH="C:/ffmpeg/bin/ffmpeg.exe"
# FFPROBE_PATH="C:/ffmpeg/bin/ffprobe.exe"

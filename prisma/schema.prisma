generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SubmissionStatus {
  submitted
  approved
  paid
  rejected
}

/// Who caused a revision. Only editor_error counts against an editor's meter —
/// a client changing their mind is not the editor's mistake.
enum RevisionReason {
  editor_error
  brief_change
}

model Editor {
  id          String            @id @default(uuid())
  name        String
  editorCode  String            @unique
  pinHash     String
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  submissions  VideoSubmission[]
  hookPresets  HookPreset[]
  workSessions WorkSession[]
}

/// A saved hook-text style for the overlay tool in the editor portal.
model HookPreset {
  id   String  @id @default(uuid())
  name String
  /// The built-in house style. Exactly one row carries this, and it is
  /// read-only for everyone — editors duplicate it rather than edit it.
  isDefault Boolean @default(false)
  /// Null means global (the default, visible to every editor). Otherwise the
  /// preset belongs to that editor and only they can see or change it.
  ownerEditorId String?
  owner         Editor? @relation(fields: [ownerEditorId], references: [id], onDelete: Cascade)
  /// Whole HookConfig blob — see lib/hook/spec.ts. Stored loose on purpose so
  /// adding a style token doesn't need a migration; normalizeConfig backfills
  /// anything an older preset predates.
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerEditorId])
}

model AdminUser {
  id        String   @id @default(uuid())
  name      String
  loginCode String   @unique
  pinHash   String
  role      String   @default("owner")
  createdAt DateTime @default(now())
}

model VideoStyle {
  id                            String            @id @default(uuid())
  name                          String
  isCustomPricing               Boolean           @default(false)
  ratePerMinuteCents            Int?
  /// Step pricing: when > 0, ratePerMinuteCents becomes a flat base covering the first minute, and each additional minute adds this flat amount (1 min = rate, 2 min = rate+this, 3 min = rate+2x this...). 0 = ratePerMinuteCents is a plain per-minute rate (duration x rate).
  perMinuteIncrementCents       Int               @default(0)
  /// Client-facing billing rate for invoices — deliberately separate from ratePerMinuteCents (what the editor is paid). Only visible/editable behind the invoice password gate.
  /// When clientBaseSeconds = 0: clientRatePerMinuteCents is a plain per-minute rate (duration x rate), clientPerMinuteIncrementCents unused.
  /// When clientBaseSeconds > 0: clientRatePerMinuteCents is a flat base price covering up to that many seconds; clientPerMinuteIncrementCents is the overage rate per clientOverageUnitSeconds unit beyond it. clientOverageProportional=true bills overage continuously (no rounding); false bills in whole units, only advancing to the next unit once more than clientOverageGraceSeconds past the boundary.
  clientRatePerMinuteCents      Int?
  clientPerMinuteIncrementCents Int               @default(0)
  clientBaseSeconds             Int               @default(0)
  clientOverageUnitSeconds      Int               @default(60)
  clientOverageGraceSeconds     Int               @default(0)
  clientOverageProportional     Boolean           @default(false)
  active                        Boolean           @default(true)
  sortOrder                     Int               @default(0)
  createdAt                     DateTime          @default(now())
  updatedAt                     DateTime          @updatedAt
  submissions                   VideoSubmission[]
}

model VideoSubmission {
  id                   String           @id @default(uuid())
  editorId             String
  editor               Editor           @relation(fields: [editorId], references: [id], onDelete: Cascade)
  styleId              String
  style                VideoStyle       @relation(fields: [styleId], references: [id])
  styleName            String
  title                String
  clientOrProject      String?
  videoLink            String
  durationMinutes      Float
  pricePerMinuteCents  Int
  calculatedPriceCents Int
  status               SubmissionStatus @default(submitted)
  /// Snapshot of AppSettings.currentBatch at submission time. Admin-only grouping — editors never pick this themselves.
  batchNumber          Int              @default(1)
  submittedAt          DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  notes                String?
  revisions            Revision[]
  workSessions         WorkSession[]

  @@index([editorId])
  @@index([styleId])
  @@index([status])
  @@index([submittedAt])
  @@index([batchNumber])
}

/// One round of changes QA sent back on a video. Logged by the owner/QA side
/// only — editors can see their own but never create or edit them.
model Revision {
  id           String          @id @default(uuid())
  submissionId String
  submission   VideoSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  /// 1 minor, 2 moderate, 3 major. A typo fix and a re-edit are not the same
  /// thing, so severity is scored rather than the raw count of revisions.
  severity     Int
  reason       RevisionReason  @default(editor_error)
  note         String?
  createdAt    DateTime        @default(now())

  @@index([submissionId])
}

/// A single span of an editor actually working on a video.
///
/// Deliberately many-per-submission: the clock stops when the editor submits
/// and restarts if the video comes back for rework, so QA's review queue is
/// never charged to the editor. Total editor time is the sum of these spans.
model WorkSession {
  id           String           @id @default(uuid())
  editorId     String
  editor       Editor           @relation(fields: [editorId], references: [id], onDelete: Cascade)
  /// What the editor called the video when they started the clock. The
  /// submission doesn't exist yet at that point — they add the video, with its
  /// duration, once the work is finished.
  label        String           @default("")
  /// Filled in when the editor finally adds the video and picks this session.
  /// Null while the work is still in progress or unlinked.
  submissionId String?
  submission   VideoSubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  startedAt    DateTime         @default(now())
  /// Null while the timer is running. At most one open session per editor.
  endedAt      DateTime?
  /// True when the session was closed by the inactivity cap rather than by the
  /// editor, so a forgotten timer can be spotted instead of silently scoring.
  autoClosed   Boolean          @default(false)

  @@index([editorId])
  @@index([submissionId])
}

/// Singleton row (id is always "singleton") holding admin-controlled app state, currently just the active batch counter.
model AppSettings {
  id           String @id @default("singleton")
  currentBatch Int    @default(1)
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SubmissionStatus {
  submitted
  approved
  paid
  rejected
}

/// Who caused a revision. Only editor_error counts against an editor's meter —
/// a client changing their mind is not the editor's mistake.
enum RevisionReason {
  editor_error
  brief_change
}

enum ApplicantStatus {
  new
  shortlisted
  rejected
}

/// An editor applying through the public /apply page shared on stories.
/// Deliberately not linked to Editor — most of these never become one.
model Applicant {
  id       String @id @default(uuid())
  name     String
  whatsapp String
  city     String?

  /// Has actually cut AI UGC ads before, as opposed to general video work.
  hasAiAdsExperience Boolean
  portfolio          String?
  software           String
  aiTools            String?

  ownsComputer  Boolean
  computerSpecs String?
  ownsPhone     Boolean

  /// Banded rather than free text so the answers are comparable.
  hoursPerDay     String
  handlesFeedback Boolean
  turnaround      String?
  expectedPayPkr  String?
  whyYou          String?

  /// Answer to the "type this word" check. Anyone who skims past it is
  /// filtered without a human having to read their application.
  attentionAnswer String
  attentionPassed Boolean @default(false)

  status    ApplicantStatus @default(new)
  createdAt DateTime        @default(now())

  @@index([status])
  @@index([createdAt])
}

/// Where a piece of work has got to.
///   working   - the clock is running
///   submitted - handed to QA; the clock is stopped but can be resumed if the
///               video comes back for changes
///   finished  - done for good, locked, no more time can be added
enum WorkItemStatus {
  working
  submitted
  finished
}

model Editor {
  id          String            @id @default(uuid())
  name        String
  editorCode  String            @unique
  pinHash     String
  active      Boolean           @default(true)
  /// Promoted to QA by the owner from the Editors tab. Lets this editor review
  /// everyone else's work — log revisions, approve videos, sign off logged time
  /// — but never their own, and never anything to do with money.
  isQa        Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  submissions  VideoSubmission[]
  hookPresets  HookPreset[]
  workItems    WorkItem[]
}

/// A saved hook-text style for the overlay tool in the editor portal.
model HookPreset {
  id   String  @id @default(uuid())
  name String
  /// The built-in house style. Exactly one row carries this, and it is
  /// read-only for everyone — editors duplicate it rather than edit it.
  isDefault Boolean @default(false)
  /// Null means global (the default, visible to every editor). Otherwise the
  /// preset belongs to that editor and only they can see or change it.
  ownerEditorId String?
  owner         Editor? @relation(fields: [ownerEditorId], references: [id], onDelete: Cascade)
  /// Whole HookConfig blob — see lib/hook/spec.ts. Stored loose on purpose so
  /// adding a style token doesn't need a migration; normalizeConfig backfills
  /// anything an older preset predates.
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerEditorId])
}

model AdminUser {
  id        String   @id @default(uuid())
  name      String
  loginCode String   @unique
  pinHash   String
  role      String   @default("owner")
  createdAt DateTime @default(now())
}

model VideoStyle {
  id                            String            @id @default(uuid())
  name                          String
  isCustomPricing               Boolean           @default(false)
  ratePerMinuteCents            Int?
  /// Step pricing: when > 0, ratePerMinuteCents becomes a flat base covering the first minute, and each additional minute adds this flat amount (1 min = rate, 2 min = rate+this, 3 min = rate+2x this...). 0 = ratePerMinuteCents is a plain per-minute rate (duration x rate).
  perMinuteIncrementCents       Int               @default(0)
  /// Client-facing billing rate for invoices — deliberately separate from ratePerMinuteCents (what the editor is paid). Only visible/editable behind the invoice password gate.
  /// When clientBaseSeconds = 0: clientRatePerMinuteCents is a plain per-minute rate (duration x rate), clientPerMinuteIncrementCents unused.
  /// When clientBaseSeconds > 0: clientRatePerMinuteCents is a flat base price covering up to that many seconds; clientPerMinuteIncrementCents is the overage rate per clientOverageUnitSeconds unit beyond it. clientOverageProportional=true bills overage continuously (no rounding); false bills in whole units, only advancing to the next unit once more than clientOverageGraceSeconds past the boundary.
  clientRatePerMinuteCents      Int?
  clientPerMinuteIncrementCents Int               @default(0)
  clientBaseSeconds             Int               @default(0)
  clientOverageUnitSeconds      Int               @default(60)
  clientOverageGraceSeconds     Int               @default(0)
  clientOverageProportional     Boolean           @default(false)
  active                        Boolean           @default(true)
  sortOrder                     Int               @default(0)
  createdAt                     DateTime          @default(now())
  updatedAt                     DateTime          @updatedAt
  submissions                   VideoSubmission[]
}

model VideoSubmission {
  id                   String           @id @default(uuid())
  editorId             String
  editor               Editor           @relation(fields: [editorId], references: [id], onDelete: Cascade)
  styleId              String
  style                VideoStyle       @relation(fields: [styleId], references: [id])
  styleName            String
  title                String
  clientOrProject      String?
  videoLink            String
  durationMinutes      Float
  pricePerMinuteCents  Int
  calculatedPriceCents Int
  status               SubmissionStatus @default(submitted)
  /// Snapshot of AppSettings.currentBatch at submission time. Admin-only grouping — editors never pick this themselves.
  batchNumber          Int              @default(1)
  submittedAt          DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  notes                String?
  revisions            Revision[]
  workItem             WorkItem?

  @@index([editorId])
  @@index([styleId])
  @@index([status])
  @@index([submittedAt])
  @@index([batchNumber])
}

/// One round of changes QA sent back on a video. Logged by the owner/QA side
/// only — editors can see their own but never create or edit them.
model Revision {
  id           String          @id @default(uuid())
  submissionId String
  submission   VideoSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  /// 1 minor, 2 moderate, 3 major. A typo fix and a re-edit are not the same
  /// thing, so severity is scored rather than the raw count of revisions.
  severity     Int
  reason       RevisionReason  @default(editor_error)
  note         String?
  createdAt    DateTime        @default(now())

  @@index([submissionId])
}

/// One video an editor is working on, from first keystroke to final sign-off.
///
/// Exists before the VideoSubmission does: the editor names the video and
/// starts the clock, and only adds the record — with its duration — once the
/// work is done. Survives revision rounds, accumulating spans each time.
model WorkItem {
  id           String           @id @default(uuid())
  editorId     String
  editor       Editor           @relation(fields: [editorId], references: [id], onDelete: Cascade)
  /// What the editor called it when they started, e.g. "Rosabella #2".
  label        String
  /// Set when the editor finally adds the video and attaches this work.
  /// Unique: one piece of tracked work belongs to at most one video.
  submissionId String?          @unique
  submission   VideoSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  status       WorkItemStatus   @default(working)
  finishedAt   DateTime?
  /// QA's sign-off that the logged time is honest. Only approved time feeds
  /// the leaderboard — the clock is self-reported, so it needs a second pair
  /// of eyes before it can move money.
  timeApprovedAt DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  sessions     WorkSession[]

  @@index([editorId])
  @@index([status])
}

/// A single unbroken span of the clock running on a WorkItem. Total editor
/// time is the sum of these, so QA's review queue is never charged to them.
model WorkSession {
  id         String    @id @default(uuid())
  workItemId String
  workItem   WorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  startedAt  DateTime  @default(now())
  /// Null while the timer is running. At most one open span per editor.
  endedAt    DateTime?
  /// True when closed by the cap rather than by the editor, so a forgotten
  /// timer can be spotted instead of silently scoring.
  autoClosed Boolean   @default(false)

  @@index([workItemId])
}

/// Singleton row (id is always "singleton") holding admin-controlled app state, currently just the active batch counter.
model AppSettings {
  id           String @id @default("singleton")
  currentBatch Int    @default(1)
}
